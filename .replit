# Replit: run the app server (port 8790)
run = "pip install -q -r requirements.txt && python app/server.py"
modules = ["python-3.12"]

[[ports]]
localPort = 8790
externalPort = 80

[deployment]
run = ["sh", "-c", "pip install -q -r requirements.txt && python app/server.py"]
deploymentTarget = "cloudrun"
